# ===== 数据库 =====
# 数据库类型: sqlite 或 oracle
database_type=sqlite
# SQLite 配置
sqlite_url=./data/example_db.sqlite
# Oracle 配置（生产环境）
oracle_user=
oracle_password=
oracle_dsn=

# ===== AI 助手 =====
openai_api_key=
openai_api_base=https://api.openai.com/v1
ai_model=gpt-4o-mini

# ===== HCL Notes 集成 =====
notes_server_url=
notes_user=
notes_password=

# ===== 认证与安全 =====
# 生产环境务必改为随机长字符串，否则任意人可伪造 JWT
jwt_secret=cim-work-manager-secret-key-2026
jwt_expire_hours=8

# ===== CORS =====
# 允许的前端来源，逗号分隔；生产环境应限定为实际前端域名
cors_origins=http://localhost:5173
