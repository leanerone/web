# ==========================================================================
# CIM Work Manager - Oracle 生产环境配置示例
# --------------------------------------------------------------------------
# 使用方法:
#   1. 复制本文件为 .env  (放在 backend/ 目录下)
#   2. 修改以下各字段为实际值
#   3. 保存后重启后端服务即可生效 (配置类 Settings 通过 .env 自动读取)
#
# 注意:
#   - 任何含空格或特殊字符(!@#$%^&*)的值，不需要加引号
#   - 修改后无需 rebuild，但需重启 uvicorn/FastAPI 进程
#
# ── 本地 SQLite 开发模式 (不等 DBA 授权时用) ──
#   不创建 .env 文件即可 (settings.py 默认 DATABASE_TYPE=sqlite)
#   或创建 .env 仅写一行: DATABASE_TYPE=sqlite
#   初始化数据: python init_db.py  (8 条机台样本 + 项目/任务/需求)
#   导入真实数据: python import_equipment_csv.py equipment_export.csv
# ==========================================================================

# ---------- 数据库类型: oracle 或 sqlite (必改) ----------
DATABASE_TYPE=oracle

# ---------- SQLite 配置 (当 DATABASE_TYPE=sqlite 时使用，Oracle可忽略) ----------
SQLITE_URL=./data/example_db.sqlite

# ---------- Oracle 生产库配置 (当 DATABASE_TYPE=oracle 时使用，必改) ----------
# ⚠️ 使用 PANJOB 账号直连，与 EQUIPMENTINFO 同账号
#   - 新建业务表自动落在 PANJOB 默认表空间 (= EQUIPMENTINFO 所在表空间)
#   - 后端 ORM 直接映射 EQUIPMENTINFO 真表，前端只读展示
# 格式说明:
#   ORACLE_USER:  PANJOB (量产机台表 owner)
#   ORACLE_PASSWORD: PANJOB 账号密码
#   ORACLE_DSN:  Oracle连接串 (Easy Connect / TNS Name)
#     Easy Connect 示例:
#       - 单节点SID:   10.20.30.40:1521/ORCL
#       - 单节点Service: 10.20.30.40:1521/PROD_SVC.company.com
#       - RAC SCAN:    scan-vip.company.com:1521/PROD_SVC
#     TNS Name 示例 (需本机tnsnames.ora已配置): PROD_TNS
ORACLE_USER=PANJOB
ORACLE_PASSWORD=ChangeThisPassword2026
ORACLE_DSN=10.20.30.40:1521/ORCL

# ---------- AI 助手配置 (可选，不填则AI规划功能关闭) ----------
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ---------- HCL Notes 文档同步配置 (可选，不填则Notes同步功能关闭) ----------
NOTES_SERVER_URL=
NOTES_USER=
NOTES_PASSWORD=
